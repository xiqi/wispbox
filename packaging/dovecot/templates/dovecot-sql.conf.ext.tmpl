# Dovecot SQL auth — generated by wispbox. DO NOT EDIT.
# Reads mailbox credentials directly from the wispbox control database.
driver = sqlite
connect = {{ .DBPath }}

# Mailbox passwords are stored as {BLF-CRYPT} (bcrypt) hashes.
default_pass_scheme = BLF-CRYPT

password_query = \
  SELECT m.email AS user, m.password_hash AS password \
  FROM mailboxes m JOIN domains d ON d.id = m.domain_id \
  WHERE m.email = '%u' AND m.enabled = 1

user_query = \
  SELECT '{{ .MailDir }}/' || d.name || '/' || m.local_part AS home, \
         '{{ .MailUser }}' AS uid, '{{ .MailGroup }}' AS gid, \
         CASE WHEN m.quota_mb > 0 THEN '*:storage=' || m.quota_mb || 'M' ELSE NULL END AS quota_rule \
  FROM mailboxes m JOIN domains d ON d.id = m.domain_id \
  WHERE m.email = '%u' AND m.enabled = 1

iterate_query = SELECT email AS user FROM mailboxes WHERE enabled = 1
