# Dovecot 2.4 SQL auth — generated by Wispbox. DO NOT EDIT.
# 2.4 inlines the SQL connection (no separate driver/connect file) and uses
# named passdb sql {} / userdb sql {} blocks. %u becomes %{user}.
sql_driver = sqlite
sqlite_path = {{ .DBPath }}

# Mailbox passwords are stored as {BLF-CRYPT} (bcrypt) hashes.
passdb sql {
  default_password_scheme = BLF-CRYPT
  query = SELECT m.email AS user, m.password_hash AS password \
    FROM mailboxes m JOIN domains d ON d.id = m.domain_id \
    WHERE m.email = '%{user}' AND m.enabled = 1
}

userdb sql {
  # userdb_quota_storage_size sets the per-mailbox quota limit. The
  # userdb_ prefix is required for a userdb field to override a setting;
  # without it the value parses fine but the quota is silently NOT applied.
  query = SELECT '{{ .MailDir }}/' || d.name || '/' || m.local_part AS home, \
    '{{ .MailUser }}' AS uid, '{{ .MailGroup }}' AS gid, \
    m.quota_mb || 'M' AS userdb_quota_storage_size \
    FROM mailboxes m JOIN domains d ON d.id = m.domain_id \
    WHERE m.email = '%{user}' AND m.enabled = 1
  iterate_query = SELECT email AS user FROM mailboxes WHERE enabled = 1
}
