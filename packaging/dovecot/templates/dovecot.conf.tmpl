# =====================================================================
# Dovecot configuration — generated by wispbox. DO NOT EDIT.
# Regenerated from the wispbox database on every configuration change.
# =====================================================================

protocols = imap lmtp

# --- Mail storage: Maildir owned by the wispbox user --------------------
mail_location = maildir:{{ .MailDir }}/%d/%n/Maildir
mail_uid = {{ .MailUser }}
mail_gid = {{ .MailGroup }}
first_valid_uid = 100
mail_privileged_group =

namespace inbox {
  inbox = yes
  separator = /
  mailbox Drafts {
    auto = subscribe
    special_use = \Drafts
  }
  mailbox Sent {
    auto = subscribe
    special_use = \Sent
  }
  mailbox Trash {
    auto = subscribe
    special_use = \Trash
  }
  mailbox Junk {
    auto = subscribe
    special_use = \Junk
  }
}

# --- Authentication: SQL against the wispbox control database -----------
disable_plaintext_auth = yes
auth_mechanisms = plain login

passdb {
  driver = sql
  args = {{ .GeneratedDovecotDir }}/dovecot-sql.conf.ext
}
userdb {
  driver = sql
  args = {{ .GeneratedDovecotDir }}/dovecot-sql.conf.ext
}

# --- TLS: certificates managed by wispboxd -------------------------------
ssl = required
ssl_min_protocol = TLSv1.2
ssl_prefer_server_ciphers = yes
ssl_cert = <{{ .DefaultCertPath }}
ssl_key = <{{ .DefaultKeyPath }}
{{ range .SNI }}
local_name {{ .Hostname }} {
  ssl_cert = <{{ .CertPath }}
  ssl_key = <{{ .KeyPath }}
}
{{ end }}

# --- Services -------------------------------------------------------------
# IMAPS (993) is public. Plain IMAP (143) binds loopback only: it exists for
# wispboxd's webmail IMAP adapter. Loopback counts as "secured" so plaintext
# auth is allowed there without TLS.
service imap-login {
  inet_listener imap {
    address = 127.0.0.1
    port = 143
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
  service_count = 1
  process_min_avail = 0
  process_limit = 4
  client_limit = 8
}

service imap {
  process_limit = 8
}

# LMTP receives local deliveries from Postfix.
service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    user = postfix
    group = postfix
    mode = 0600
  }
  process_limit = 4
}

# SASL for Postfix submission auth.
service auth {
  unix_listener /var/spool/postfix/private/auth {
    user = postfix
    group = postfix
    mode = 0660
  }
  client_limit = 32
}

# The SQL passdb/userdb run in auth workers. They read (and, because of
# SQLite WAL, occasionally write journal files next to) the wispbox control
# database, so they run as the wispbox user.
service auth-worker {
  user = {{ .MailUser }}
  process_limit = 2
}

# --- Quota (enforced at LMTP delivery and reported over IMAP) -------------
mail_plugins = $mail_plugins quota
protocol imap {
  mail_plugins = $mail_plugins imap_quota
  mail_max_userip_connections = 8
}
protocol lmtp {
  mail_plugins = $mail_plugins quota
}
plugin {
  quota = maildir:User quota
  quota_grace = 5%%
}

# --- Small-server tuning ----------------------------------------------------
default_process_limit = 20
default_client_limit = 64
default_vsz_limit = 96M

log_path = syslog
syslog_facility = mail
