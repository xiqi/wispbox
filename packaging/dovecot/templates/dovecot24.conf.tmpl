dovecot_config_version = 2.4.0
dovecot_storage_version = 2.4.0

# =====================================================================
# Dovecot 2.4 configuration — generated by Wispbox. DO NOT EDIT.
# Used on systems shipping Dovecot 2.4+ (Debian 13, Ubuntu 26.04).
# Regenerated from the Wispbox database on every configuration change.
# =====================================================================

protocols = imap lmtp

# --- Mail storage: Maildir owned by the wispbox user --------------------
# 2.4 splits the old mail_location into mail_driver + mail_path, and %d/%n
# become %{user | domain}/%{user | username}.
mail_driver = maildir
mail_path = {{ .MailDir }}/%{user | domain}/%{user | username}/Maildir
mail_uid = {{ .MailUser }}
mail_gid = {{ .MailGroup }}
first_valid_uid = 100

namespace inbox {
  inbox = yes
  separator = /
  mailbox Drafts {
    auto = subscribe
    special_use = \Drafts
  }
  mailbox Sent {
    auto = subscribe
    special_use = \Sent
  }
  mailbox Trash {
    auto = subscribe
    special_use = \Trash
  }
  mailbox Junk {
    auto = subscribe
    special_use = \Junk
  }
}

# --- Authentication: SQL against the Wispbox control database ------------
# auth_allow_cleartext=no is the 2.4 spelling of the old plaintext-auth
# toggle. Loopback is still treated as secured, so the loopback IMAP
# listener below can still authenticate.
auth_allow_cleartext = no
auth_mechanisms = plain login
!include {{ .GeneratedDovecotDir }}/dovecot-sql.conf.ext

# --- Quota: per-mailbox storage limit -----------------------------------
# Protects small-disk servers: a runaway mailbox can't fill the disk and
# take the whole mail stack down, and the quota shown in the admin UI
# actually means something. The count driver tracks usage in Dovecot's
# index (recommended for 2.4); the per-user limit comes from the userdb's
# userdb_quota_storage_size field (see dovecot-sql.conf.ext).
mail_plugins {
  quota = yes
}
protocol imap {
  mail_plugins {
    imap_quota = yes
  }
}
quota "User quota" {
  driver = count
}

# --- TLS: certificates managed by wispboxd (2.4 setting names) -----------
# ssl_cert/ssl_key became ssl_server_cert_file/ssl_server_key_file and take
# a plain path (the old `<` prefix is gone). A default cert is required so
# non-SNI clients still get a certificate.
ssl = required
ssl_min_protocol = TLSv1.2
ssl_server_cert_file = {{ .DefaultCertPath }}
ssl_server_key_file = {{ .DefaultKeyPath }}
{{ range .SNI }}
local_name {{ .Hostname }} {
  ssl_server_cert_file = {{ .CertPath }}
  ssl_server_key_file = {{ .KeyPath }}
}
{{ end }}

# --- Services -------------------------------------------------------------
# IMAPS (993) is public. Plain IMAP (143) binds loopback only, for wispboxd's
# webmail IMAP adapter; loopback counts as secured so plaintext auth works.
service imap-login {
  inet_listener imap {
    address = 127.0.0.1
    port = 143
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
  service_count = 1
  process_min_avail = 0
  process_limit = 4
  client_limit = 8
}

service imap {
  process_limit = 8
}

# LMTP receives local deliveries from Postfix.
service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    user = postfix
    group = postfix
    mode = 0600
  }
  process_limit = 4
}

# SASL for Postfix submission auth.
service auth {
  unix_listener /var/spool/postfix/private/auth {
    user = postfix
    group = postfix
    mode = 0660
  }
  client_limit = 32
}

# SQL auth runs in auth workers, which read the Wispbox control database
# (SQLite WAL journals write next to it), so they run as the wispbox user.
service auth-worker {
  user = {{ .MailUser }}
  process_limit = 2
}

# --- Small-server tuning ----------------------------------------------------
default_process_limit = 20
default_client_limit = 64
default_vsz_limit = 96M

log_path = syslog
syslog_facility = mail
