# OpenDKIM configuration — generated by wispbox. DO NOT EDIT.
Syslog                  yes
SyslogSuccess           yes
Canonicalization        relaxed/simple
Mode                    sv
SubDomains              no
OversignHeaders         From
UserID                  opendkim
UMask                   007

# wispbox stores signing keys 0640 wispbox:wispbox and grants the opendkim
# user read access through the wispbox group (see the installer). OpenDKIM's
# default RequireSafeKeys refuses keys it does not own and whose parent dirs
# are group/other-writable, which would reject this group-share model, so we
# disable it. Keys are never group- or world-writable.
RequireSafeKeys         no
Socket                  inet:8891@127.0.0.1
PidFile                 /run/opendkim/opendkim.pid
TrustAnchorFile         /usr/share/dns/root.key

KeyTable                file:{{ .GeneratedOpenDKIMDir }}/key.table
SigningTable            refile:{{ .GeneratedOpenDKIMDir }}/signing.table
InternalHosts           127.0.0.1/8, ::1
