# =====================================================================
# Postfix main.cf — generated by wispbox. DO NOT EDIT.
# Regenerated from the wispbox database on every configuration change.
# Manual changes are overwritten. Manage mail through the Admin UI.
# =====================================================================

compatibility_level = 3.6
myhostname = {{ .PrimaryHostname }}
myorigin = $myhostname
mydestination = localhost
mynetworks = 127.0.0.0/8 [::1]/128
inet_interfaces = all
inet_protocols = all
biff = no
append_dot_mydomain = no
recipient_delimiter = +
smtpd_banner = $myhostname ESMTP
message_size_limit = {{ .MessageSizeLimit }}
mailbox_size_limit = 0

# --- Small-server resource limits (512MB friendly) -------------------
default_process_limit = 12
smtpd_client_connection_count_limit = 5
qmgr_message_active_limit = 200
default_destination_concurrency_limit = 5
smtp_destination_concurrency_limit = 5

# --- Virtual domains, mailboxes, aliases ------------------------------
virtual_mailbox_domains = texthash:{{ .PostfixMapDir }}/virtual_domains
virtual_mailbox_maps = texthash:{{ .PostfixMapDir }}/virtual_mailboxes
virtual_alias_maps = texthash:{{ .PostfixMapDir }}/virtual_aliases
virtual_transport = lmtp:unix:private/dovecot-lmtp

# --- Inbound TLS (certificates managed by wispboxd) --------------------
smtpd_tls_security_level = may
smtpd_tls_chain_files =
    {{ .DefaultKeyPath }},
    {{ .DefaultCertPath }}
tls_server_sni_maps = texthash:{{ .PostfixMapDir }}/sni_maps
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtpd_tls_loglevel = 1

# --- Outbound TLS ------------------------------------------------------
smtp_tls_security_level = may
smtp_tls_protocols = >=TLSv1.2
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache
smtp_tls_policy_maps = texthash:{{ .PostfixMapDir }}/tls_policy
smtp_tls_loglevel = 1

# --- SASL auth via Dovecot (used on the submission port only) ----------
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = no

# --- No open relay ------------------------------------------------------
# Port 25 accepts mail only for domains wispbox hosts. Authenticated
# submission happens on 587 (see master.cf).
smtpd_helo_required = yes
smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    defer_unauth_destination
smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination,
    reject_unlisted_recipient
smtpd_sender_restrictions =
    reject_non_fqdn_sender,
    reject_unknown_sender_domain
smtpd_data_restrictions = reject_unauth_pipelining

# --- Sender identity enforcement ----------------------------------------
# Authenticated users may only send as their own mailbox or an alias that
# forwards to them. Enforced on the submission service in master.cf via
# reject_sender_login_mismatch.
smtpd_sender_login_maps = texthash:{{ .PostfixMapDir }}/sender_logins

# --- Outbound delivery policy (direct vs relay) --------------------------
# Per-sender-domain transport selection generated from wispbox delivery
# policies. Missing entries use default_transport (the global policy).
sender_dependent_default_transport_maps = texthash:{{ .PostfixMapDir }}/sender_transport
default_transport = {{ .DefaultTransport }}
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = texthash:{{ .PostfixMapDir }}/sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_sasl_mechanism_filter = plain, login
{{ if .DKIMEnabled }}
# --- DKIM signing via OpenDKIM milter ------------------------------------
# milter_default_action=accept keeps mail flowing if OpenDKIM is down.
smtpd_milters = inet:127.0.0.1:8891
non_smtpd_milters = inet:127.0.0.1:8891
milter_default_action = accept
milter_protocol = 6
{{ end }}
